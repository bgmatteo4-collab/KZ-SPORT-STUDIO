# ── Source de données ────────────────────────────────────────────────────────
# simulator  : rejoue un match enregistré, sans réseau.
# espn       : le direct, sans jeton. Couvre la Ligue des Champions et la
#              Ligue 1. API non documentée : lire la note en tête de
#              packages/providers/src/espn/index.ts avant de s'y fier.
# sportmonks : le direct, sous licence. Demande un jeton, et un palier payant
#              pour autre chose que la Superliga danoise et la Premiership
#              écossaise.
KZ_PROVIDER=simulator

# ── ESPN ─────────────────────────────────────────────────────────────────────
# Le championnat. `pnpm espn live` liste les matchs en cours partout.
ESPN_LEAGUE=uefa.champions

# Le match. Vide, on prend le premier en cours du championnat — ce qu'on veut
# neuf fois sur dix en lançant pendant une soirée.
# ESPN_EVENT_ID=

# Les autres rencontres de la soirée, pour le multiplex. 0 pour couper.
KZ_MULTIPLEX=1

# Le jeton Sportmonks. À coller ici, dans un fichier .env qui n'est JAMAIS
# commité. Ne le mets nulle part ailleurs, et ne le colle pas dans une
# conversation.
SPORTMONKS_TOKEN=

# Le match à suivre. `pnpm sportmonks live` donne les identifiants en cours.
SPORTMONKS_FIXTURE_ID=

# Enregistrer les réponses brutes pendant qu'on diffuse. Ça ne coûte rien et
# ça transforme chaque match réel en fixture rejouable.
# KZ_RECORD=recordings/ce-soir.jsonl

# Demander les coordonnées du ballon (palier supérieur requis). 0 pour couper.
KZ_BALL=1

# ── Rejeu ────────────────────────────────────────────────────────────────────
KZ_FIXTURE=fixtures/demo-ucl.json
KZ_REPLAY_SPEED=1
# Entrer dans le match à la vingtième minute plutôt qu'au coup d'envoi.
KZ_START_AT=1200000

# ── Serveur ──────────────────────────────────────────────────────────────────
KZ_PORT=4100
# Où la régie garde ses réglages entre deux démarrages.
KZ_STATE=.kz/control.json
