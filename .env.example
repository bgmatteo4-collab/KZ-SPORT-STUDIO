# Jeton Sportmonks — à coller dans un fichier .env (jamais commité)
SPORTMONKS_TOKEN=

# Source de données : simulator | sportmonks
KZ_PROVIDER=simulator

# Match rejoué quand KZ_PROVIDER=simulator
KZ_FIXTURE=fixtures/demo-ucl.json

# Vitesse de rejeu (1 = temps réel, 20 = vingt fois plus vite)
KZ_REPLAY_SPEED=1

# Port du serveur temps réel
KZ_PORT=4100
