{
  "name": "kz-studio",
  "private": true,
  "version": "0.1.0",
  "description": "Moteur d'habillage broadcast pour watchalongs football",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n serveur,web -c cyan,magenta \"pnpm dev:server\" \"pnpm dev:web\"",
    "dev:server": "tsx watch apps/server/src/index.ts",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "check": "tsc --noEmit -p tsconfig.json",
    "fixture": "tsx packages/providers/src/generate-fixture.ts",
    "showcase": "vite build --config vite.showcase.config.ts && python3 tools/assemble-showcase.py",
    "test": "tsx --test \"packages/**/*.test.ts\"",
    "verify": "tsc --noEmit -p tsconfig.json && pnpm test && python3 tools/lint-obs-css.py && python3 tools/lint-sources.py",
    "sportmonks": "tsx tools/sportmonks.ts",
    "espn": "tsx tools/espn.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  },
  "dependencies": {
    "ws": "^8.18.0",
    "@kz/core": "workspace:*",
    "@kz/providers": "workspace:*"
  },
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20.11"
  }
}
